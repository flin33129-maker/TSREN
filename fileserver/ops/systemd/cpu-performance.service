[Unit]
Description=Keep CPU governor on performance (AI inference box)
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c "for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > $g; done"
ExecStartPost=/bin/sh -c "for p in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do [ -w $p ] && echo performance > $p; done; true"

[Install]
WantedBy=multi-user.target
